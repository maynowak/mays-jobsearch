# Used ONLY by the /api/match and /api/cover-letter serverless functions (server side).
# Never exposed to the browser. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: pick a different OpenRouter model.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Second AI provider: EdenAI (optional) ---

# EdenAI is an optional second provider. The provider router uses OpenRouter
# first and falls back to EdenAI when OpenRouter reports a provider-level quota
# exhaustion. Keys are used ONLY server side, never exposed to the browser.
# Create a production key at https://www.edenai.co/ (API key) or generate a
# sandbox token via POST /v2/user/custom_token/ (token_type: sandbox_api_token).
# EDENAI_API_KEY=your_production_api_token_here
# EDENAI_DEV_API_KEY=your_sandbox_token_here

# Key selection: EDENAI_ENV overrides the mode. Without it the app uses
# VERCEL_ENV === "production" to decide. In production EDENAI_API_KEY is used,
# everywhere else EDENAI_DEV_API_KEY is preferred (sandbox, no cost, simulated
# responses). Missing keys simply disable the provider, they never block the
# other provider.
# EDENAI_ENV=production

# Optional: pick a different EdenAI model (must be free by pricing, e.g. one of
# the zero-cost catalog entries). Otherwise the best free eligible model is used.
# EDENAI_MODEL=google/gemma-4-26b-a4b-it

# Optional: disable a provider entirely.
# OPENROUTER_ENABLED=true
# EDENAI_ENABLED=true

# --- Second job source: Arbeitsagentur via Apify (optional) ---

# Without this token the app keeps working with Arbeitnow only.
# Create a token at https://console.apify.com/settings/integrations
# APIFY_API_TOKEN=your_apify_token_here

# --- Job sources: enable/disable each source (both default to enabled) ---
#
# Sources are registered in api/_lib/sources/ (JobSource registry + Apify Actor
# registry). Setting a source to "false" skips it entirely: no API request, no
# Apify run, no dataset read, no cache miss, no cost, no jobs from it. The other
# sources keep working. If all sources are disabled the API returns a clean
# empty state (no error).
# JOB_SOURCE_ARBEITNOW_ENABLED=true
# JOB_SOURCE_ARBEITSAGENTUR_ENABLED=true

# --- Daily job alerts (optional feature) ---

# Redis store for alert subscriptions (free tier at https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-account.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Email provider for the daily digest (free tier at https://resend.com).
# DIGEST_FROM must be an address on a domain you verified in Resend.
RESEND_API_KEY=re_your-key
DIGEST_FROM="My Job Matcher <digest@your-domain.com>"

# Protects the /api/cron/digest endpoint. Generate any random string.
# CRON_SECRET=your-random-secret

# --- Cost guard & usage (all optional, safe defaults shown) ---

# Advisory soft limits in USD for operators. The app cannot compute provider
# spend, so these do NOT block anything by themselves — the provider dashboards
# are authoritative for billing. Application-side guards use the counter-based
# backstops below instead. Diagnostics: GET /api/usage
# OPENROUTER_MONTHLY_SOFT_LIMIT_USD=0.80
# APIFY_MONTHLY_SOFT_LIMIT_USD=4.00

# Application-side counter backstops (estimates, not provider billing).
# When reached, new AI requests / Apify Actor runs are refused gracefully
# (existing cached/dataset-reused data keeps working).
# OPENROUTER_MONTHLY_MAX_REQUESTS=1000
# EDENAI_MONTHLY_MAX_REQUESTS=200
# APIFY_MONTHLY_MAX_RUNS=30

# Advisory soft limit in USD for the EdenAI provider (operator threshold, not a
# hard guard). Diagnostics: GET /api/usage
# EDENAI_MONTHLY_SOFT_LIMIT_USD=1.00

# Max AI model fallback attempts (the client reads this from /api/models).
# MODEL_FALLBACK_MAX_ATTEMPTS=3

# Apify dataset reuse window in hours. During peak hours the dataset is
# refreshed more often (peak value); off-peak it is reused longer (off-peak
# value). A longer window = fewer paid runs.
# APIFY_DATASET_REFRESH_PEAK_HOURS=6
# APIFY_DATASET_REFRESH_OFFPEAK_HOURS=12

# Apify peak window: IANA timezone + start/end times. Defaults are Europe/Berlin
# 08:00-18:00. Sommer-/Winterzeit (DST) is handled automatically via the IANA
# timezone (no hardcoded UTC offset).
# APIFY_DATASET_REFRESH_TIMEZONE=Europe/Berlin
# APIFY_DATASET_REFRESH_PEAK_START=08:00
# APIFY_DATASET_REFRESH_PEAK_END=18:00

# Protects GET /api/usage. Required to READ usage counters; without a token the
# endpoint is disabled (HTTP 403). Send it via the "x-usage-token" header
# (or "Authorization: Bearer <token>"). Never expose it to the browser.
# USAGE_DIAGNOSTICS_TOKEN=your-random-secret
