{
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/landingspage2",
      "destination": "/index.html"
    },
    {
      "source": "/registrieren",
      "destination": "/index.html"
    },
    {
      "source": "/anmelden",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/profil",
      "destination": "/index.html"
    },
    {
      "source": "/impressum",
      "destination": "/index.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/index.html"
    },
    {
      "source": "/datenschutzprinzipien",
      "destination": "/index.html"
    }
  ]
}
