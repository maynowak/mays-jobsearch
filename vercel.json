{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/search",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/cv-builder/workspace",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/landingspage2",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/registrieren",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/anmelden",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/auth/callback",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/profil",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/email-bestaetigen",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/impressum",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/datenschutz",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/datenschutzprinzipien",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/dev/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/api/ris/router",
      "destination": "/404",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/ris/applications",
      "destination": "/api/ris/router?__ris_applications=1"
    },
    {
      "source": "/api/ris/consents",
      "destination": "/api/ris/router?__ris_consents=1"
    },
    {
      "source": "/api/ris/cvs",
      "destination": "/api/ris/router?__ris_cvs=1"
    },
    {
      "source": "/api/ris/cv-consents",
      "destination": "/api/ris/router?__ris_cv_consents=1"
    },
    {
      "source": "/api/ris/search-profile-consents",
      "destination": "/api/ris/router?__ris_search_profile_consents=1"
    },
    {
      "source": "/api/ris/search-profiles",
      "destination": "/api/ris/router?__ris_search_profiles=1"
    },
    {
      "source": "/api/ris/cv-builder-profiles",
      "destination": "/api/ris/router?__ris_cv_builder_profiles=1"
    },
    {
      "source": "/api/ris/erasure",
      "destination": "/api/ris/router?__ris_erasure=1"
    },
    {
      "source": "/search",
      "destination": "/app.html"
    },
    {
      "source": "/cv-builder/workspace",
      "destination": "/app.html"
    },
    {
      "source": "/landingspage2",
      "destination": "/app.html"
    },
    {
      "source": "/registrieren",
      "destination": "/app.html"
    },
    {
      "source": "/anmelden",
      "destination": "/app.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/app.html"
    },
    {
      "source": "/profil",
      "destination": "/app.html"
    },
    {
      "source": "/impressum",
      "destination": "/app.html"
    },
    {
      "source": "/email-bestaetigen",
      "destination": "/app.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/app.html"
    },
    {
      "source": "/datenschutzprinzipien",
      "destination": "/app.html"
    }
  ]
}
